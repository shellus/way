{
  "name": "@shellus/way",
  "version": "0.6.11",
  "description": "将备份作为持续运营的项目，而非一次性任务。基于 restic 的策略封装。",
  "type": "module",
  "bin": {
    "way": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --clean",
    "build:standalone": "bun build src/cli.ts --compile --target=bun-linux-x64-baseline --outfile dist/standalone/way",
    "package:linux-x64": "npm run build:standalone && node scripts/package-release.mjs",
    "dev": "tsup src/cli.ts --format esm --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "prepublishOnly": "npm run test:run && npm run build"
  },
  "files": [
    "dist",
    "vendor",
    "repositories.yaml.example",
    "rules.yaml.example",
    "migrate-to-v0.5.sh"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shellus/way.git"
  },
  "keywords": [
    "backup",
    "restic",
    "snapshot",
    "systemd"
  ],
  "author": "shellus",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/shellus/way/issues"
  },
  "homepage": "https://github.com/shellus/way#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "js-yaml": "^5.3.0",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
