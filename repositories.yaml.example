# 备份目的地配置 (restic repositories)
# 凭证直接填写明文（不再支持环境变量）
# 复制为 repositories.yaml 并填入实际值

default: local

repositories:
  local:
    type: local
    path: /tmp/way-backup
    credentials:
      password: test123

  s3:
    type: s3
    endpoint: s3.example.com
    bucket: my-backup-bucket
    region: region-1
    options:
      bucket_lookup: dns
    credentials:
      password: your-restic-password
      access_key_id: your-access-key
      secret_access_key: your-secret-key

  sftp:
    type: sftp
    host: backup.example.com
    path: /backup/myhost
    credentials:
      password: your-restic-password

  # 通过 rclone 访问 restic 未原生支持的存储（网盘等）
  drive:
    type: rclone
    remote: myremote          # rclone 配置中的 remote 名称
    path: way/myhost
    options:
      rclone_program: /usr/local/bin/rclone   # 可选，默认使用 PATH 中的 rclone
      rclone_config: /root/.way/rclone.conf   # 可选，作为 RCLONE_CONFIG 传给 rclone
      pack_size: 64                           # 可选，restic --pack-size（MiB）
    credentials:
      password: your-restic-password
